# Application-specific
# ============================================================================
# Local database files
*.db
*.sqlite
*.sqlite3
*.dbm
*.gdbm

# Logs
logs/
*.log
*.log.*

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.backup
*.cache

# Model cache (LLM models can be large)
ollama/
models/
*.onnx
*.pb
*.pth
*.pt

# Data files (large CSVs, datasets)
# Ignore all CSVs in datasets folders (they're large and local)
data/datasets/*/*.csv
backend/data/datasets/*/*.csv

# But ALLOW schema files (they're the structure)
!data/datasets/
!backend/data/datasets/
!backend/metadata/datasets/
!metadata/datasets/
!data/datasets/*/*.json
!backend/data/datasets/*/*.json
!backend/metadata/datasets/*/*.json
!metadata/datasets/*/*.json

# OS lock files
.env.lock
npm-debug.log
yarn-error.log

