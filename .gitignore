# ============================================================================
# Root Level - Keep Essential Files
# ============================================================================
# Explicitly tracked (DO NOT ignore these):
# - README.md
# - SCALABILITY.md
# - docker-compose.yml
# - init.sql
# - setup.sh / setup.ps1
# - backend/requirements.txt
# - .env.example (template only)

# ============================================================================
# Exclude venv from git (but let's be explicit about structure)
# ============================================================================
backend/venv/
venv/
.venv/

